local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick System", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false

-- --- NinjaKunai生成メインロジック ---
local function spawnKunaiAtBody()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        
        -- 画像の仕組みを流用: NinjaKunaiを現在の体(HRP)と同じ座標に生成
        spawnToyRF:InvokeServer(
            "NinjaKunai", 
            hrp.CFrame, 
            Vector3.new(0, 0, 0) -- 向きのオフセットなし
        )
    end
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai Loop)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "アンチキック有効化: クナイの生成を開始します",
                Time = 3
            })
            
            -- ループ処理
            task.spawn(function()
                while _G.AntiKickEnabled do
                    pcall(spawnKunaiAtBody)
                    task.wait(5) -- 5秒ごとに実行（負荷軽減とキック防止のバランス）
                end
            end)
        else
            OrionLib:MakeNotification({
                Name = "System",
                Content = "アンチキックを停止しました",
                Time = 3
            })
        end
    end
})

Tab:AddButton({
    Name = "手動でクナイを1回生成",
    Callback = function()
        spawnKunaiAtBody()
    end
})

OrionLib:Init()
