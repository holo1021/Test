local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Test Hub", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "TestHubConfig",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- --- 変数管理 ---
_G.SuperThrowEnabled = false
_G.ThrowPower = 500

local ContextActionService = game:GetService("ContextActionService")
local lastGrabbedPart = nil

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- 固定した対象を可視化するためのSelectionBox
local selectionBox = Instance.new("SelectionBox")
selectionBox.Name = "AnchorSelectionBox"
selectionBox.Color3 = Color3.fromRGB(0, 170, 255) -- 水色
selectionBox.LineThickness = 0.05
selectionBox.Adornee = nil
selectionBox.Parent = game:GetService("CoreGui")

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            local target = findGrabbedTarget()
            if not target then
                for i = 1, 20 do
                    RunService.Heartbeat:Wait()
                    target = findGrabbedTarget()
                    if target then break end
                end
            end

            if target then
                lastGrabbedPart = target
                
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- スーパースロー処理
                if _G.SuperThrowEnabled then
                    pcall(function()
                        lastGrabbedPart.Anchored = false
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end
                
                -- 状態をリセット
                if selectionBox then
                    selectionBox.Adornee = nil
                end

                -- 投げた後に少し待ってから参照を消す
                task.delay(0.1, function() lastGrabbedPart = nil end)
            end
        end
    end)
end

local function handleAnchorAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        if lastGrabbedPart and lastGrabbedPart.Parent then
            pcall(function()
                -- ネットワークオーナーを自分に設定して、他のプレイヤーにも見えるようにする
                lastGrabbedPart:SetNetworkOwner(localPlayer)
                task.wait(0.05) -- ネットワークの同期を待つ
                lastGrabbedPart.Anchored = true
                selectionBox.Adornee = lastGrabbedPart
            end)
        end
    end
end

-- --- UI構成 ---
local MainTab = Window:MakeTab({ Name = "Main", Icon = "rbxassetid://4483345998" })

MainTab:AddToggle({
