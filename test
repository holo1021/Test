KickTab:AddButton({
    Name = "Bring Player",
    Callback = function()

        local target = Players:FindFirstChild(kickTargetName)
        if target and target ~= localPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local blobman = getOrSpawnBlobman()
            if blobman then
                -- 1. Remoteを探す
                local scriptObj = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                local grabRemote = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                local dropRemote = scriptObj and scriptObj:FindFirstChild("CreatureDrop")

                -- 2. DetectorとWeld/Constraintを探す
                local lDet = blobman:FindFirstChild("LeftDetector")
                local rDet = blobman:FindFirstChild("RightDetector")
                local lWeld = lDet and (lDet:FindFirstChild("LeftWeld") or lDet:FindFirstChild("RigidConstraint"))
                local rWeld = rDet and (rDet:FindFirstChild("RightWeld") or rDet:FindFirstChild("RigidConstraint"))
                
                -- Auto Sit
                local seat = blobman:FindFirstChild("VehicleSeat")
                local hum = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
                if seat and hum then
                    if seat.Occupant ~= hum then
                        localPlayer.Character.HumanoidRootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
                        seat:Sit(hum)
                        task.wait(0.3)
                    end
                end
                
                if grabRemote and dropRemote and ((lDet and lWeld) or (rDet and rWeld)) then
                    OrionLib:MakeNotification({ Name = "Executing", Content = "Bringing Player...", Time = 3 })

                    task.spawn(function()
                        -- hub-jp.lua Logic Implementation
                        local GE = ReplicatedStorage:WaitForChild("GrabEvents")
                        local blobRoot = blobman:FindFirstChild("HumanoidRootPart") or blobman.PrimaryPart
                        local SavedPos = blobRoot.CFrame
                        
                        -- Phase 1: Capture (Go to target)
                        local captureStart = tick()
                        while tick() - captureStart < 0.35 do
                            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                local tRoot = target.Character.HumanoidRootPart
                                blobRoot.Anchored = false
                                blobRoot.CFrame = tRoot.CFrame
                                blobRoot.AssemblyLinearVelocity = Vector3.zero
                                
                                pcall(function()
                                    if rDet then grabRemote:FireServer(rDet, tRoot, rWeld) end -- 右手で掴む
                                    if lDet then grabRemote:FireServer(lDet, tRoot, lWeld) end -- 左手で掴む
                                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                                    GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame) -- ネットワークオーナーを設定
                                end)
                            end
                            RunService.Heartbeat:Wait()
                        end
                        
                        -- Phase 2: Bring (Come to me)
                        local bringStart = tick()
                        while tick() - bringStart < 0.8 do
                            local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                            
                            if myRoot then
                                local holdPos = myRoot.CFrame * CFrame.new(0, 0, -5)
                                
                                blobRoot.CFrame = holdPos -- アンカーせずにCFrameを継続的に設定します
                                blobRoot.Anchored = true
                                blobRoot.CFrame = holdPos
                                blobRoot.AssemblyLinearVelocity = Vector3.zero
                                blobRoot.AssemblyAngularVelocity = Vector3.zero
                                
                                if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                    local tRoot = target.Character.HumanoidRootPart
                                    local tHum = target.Character:FindFirstChild("Humanoid")
                                    if tHum then 
                                        tHum.PlatformStand = true
                                        tHum.Sit = true
                                    end
                                    -- tRoot.CFrame = holdPos -- 削除: Weldされている状態でCFrameを強制すると物理演算が競合して吹き飛びます
                                    tRoot.AssemblyLinearVelocity = Vector3.zero
                                    tRoot.AssemblyAngularVelocity = Vector3.zero
                                    GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                                end
                            end
                            RunService.Heartbeat:Wait()
                        end

                        -- Drop
                        -- 両手で掴んでいる可能性があるので、両方のWeldを解放する
                        for _, detector in ipairs({rDet, lDet}) do
                            if detector then
                                local currentWeld = detector:FindFirstChildWhichIsA("Weld") or detector:FindFirstChildWhichIsA("RigidConstraint")
                                if currentWeld then
                                    pcall(function() dropRemote:FireServer(currentWeld) end)
                                end
                            end
                        end
                        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                             GE.DestroyGrabLine:FireServer(target.Character.HumanoidRootPart)
                        end
                        
                        -- Cleanup
                        if blobRoot then
                            blobRoot.Anchored = false
                            blobRoot.CFrame = CFrame.new(0, -200, 0)
                        end
                    end)
                else
                    OrionLib:MakeNotification({ Name = "Error", Content = "Missing Remotes or Parts", Time = 5 })
                end
            else
                OrionLib:MakeNotification({ Name = "Error", Content = "Blobman not found", Time = 3 })
            end
        else
             OrionLib:MakeNotification({ Name = "Error", Content = "Target not found or invalid", Time = 3 })
        end
    end
})

