local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick System v2.1", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false
_G.DollFollowEnabled = false
local followConnection = nil
_G.DecoySync = false
local decoyConnection = nil

-- --- NinjaKunai生成メインロジック ---
local function spawnKunaiAtBody()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 画像に基づいたリモート関数の取得
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        
        -- 横（X）と高さ（Y）は維持し、前後（Z）を0.2（少し後ろ）に調整
        -- 前回の -0.5 より 0.7スタッド後ろに下がります
        local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, 0.2) 
        
        spawnToyRF:InvokeServer(
            "NinjaKunai", 
            spawnCFrame, 
            Vector3.new(0, 0, 0)
        )
    end
end

-- --- 同期ロジック ---
local function startFollowing()
    -- 前回の接続があれば解除
    if followConnection then followConnection:Disconnect() end

    followConnection = RunService.RenderStepped:Connect(function()
        if not _G.DollFollowEnabled then 
            if followConnection then followConnection:Disconnect() end
            return 
        end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        -- 自分の名前がついたおもちゃフォルダを探す
        local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        
        if hrp and toysFolder then
            -- フォルダ内にある最新の人形（おもちゃ）をすべて同期
            for _, toy in pairs(toysFolder:GetChildren()) do
                if toy:IsA("Model") and toy.PrimaryPart then
                    -- 自分のHRPと同じ位置・向きに固定
                    toy:SetPrimaryPartCFrame(hrp.CFrame)
                elseif toy:IsA("BasePart") then
                    toy.CFrame = hrp.CFrame
                end
            end
        end
    end)
end

-- --- YouDecoy同期ロジック ---
local function startDecoySync()
    if decoyConnection then decoyConnection:Disconnect() end

    decoyConnection = RunService.RenderStepped:Connect(function()
        if not _G.DecoySync then 
            if decoyConnection then decoyConnection:Disconnect() end
            return 
        end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        
        if hrp and toysFolder then
            -- フォルダ内から "YouDecoy" という名前のオブジェクトを探す
            for _, toy in pairs(toysFolder:GetChildren()) do
                if toy.Name == "YouDecoy" or toy:FindFirstChild("Humanoid") then
                    -- 自分の位置に重ねる（少し後ろにしたい場合は CFrame.new(0, 0, 2) など調整）
                    if toy:IsA("Model") then
                        toy:SetPrimaryPartCFrame(hrp.CFrame)
                    elseif toy:IsA("BasePart") then
                        toy.CFrame = hrp.CFrame
                    end
                end
            end
        end
    end)
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai Loop)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "位置を微調整してクナイ生成を開始しました",
                Time = 3
            })
            
            task.spawn(function()
                while _G.AntiKickEnabled do
                    pcall(spawnKunaiAtBody)
                    task.wait(5) -- サーバー負荷を抑えるための待機時間
                end
            end)
        end
    end
})

Tab:AddLabel("※CFrame.new(0, 0, 0.2) で前後位置を調整済み")

local SyncTab = Window:MakeTab({
    Name = "Sync Control",
    Icon = "rbxassetid://4483345998"
})

SyncTab:AddToggle({
    Name = "自分と同じ動きをさせる",
    Default = false,
    Callback = function(Value)
        _G.DollFollowEnabled = Value
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "同期を開始しました。人形を出すと重なります。",
                Time = 3
            })
            startFollowing()
        else
            if followConnection then followConnection:Disconnect() end
            OrionLib:MakeNotification({
                Name = "System",
                Content = "同期を停止しました。",
                Time = 3
            })
        end
    end
})

SyncTab:AddLabel("※NinjaKunaiや他の人形もすべて重なります")

local DecoyTab = Window:MakeTab({
    Name = "Decoy Control",
    Icon = "rbxassetid://4483345998"
})

DecoyTab:AddToggle({
    Name = "YouDecoyを同期させる",
    Default = false,
    Callback = function(Value)
        _G.DecoySync = Value
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "YouDecoyの同期を開始しました",
                Time = 3
            })
            startDecoySync()
        else
            if decoyConnection then decoyConnection:Disconnect() end
        end
    end
})

DecoyTab:AddButton({
    Name = "YouDecoyをその場に配置 (生成)",
    Callback = function()
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            spawnToyRF:InvokeServer("YouDecoy", hrp.CFrame, Vector3.new(0, 0, 0))
        end
    end
})

OrionLib:Init()
