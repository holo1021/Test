local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick & Grab Mod (Stable)", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickSimple",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false
_G.GrabKillEnabled = false
local grabbedObject = nil
local originalCollisions = {}

-- --- イベントの安全な取得 ---
-- タイムアウトを設けて、見つからない場合にスクリプト全体が止まるのを防ぐ
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10) --
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10) --
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- --- 掴みキル/すり抜け実行メイン ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if not _G.GrabKillEnabled then return end

        if isGrabbing then
            task.wait(0.1)
            local target = findGrabbedTarget()
            
            if target then
                grabbedObject = target
                local character = target.Parent
                local humanoid = character:FindFirstChild("Humanoid") or character.Parent:FindFirstChild("Humanoid")

                -- キル
                if humanoid then
                    humanoid.Health = 0
                end

                -- すり抜け
                local root = character:IsA("Model") and character or target
                pcall(function()
                    for _, p in pairs(root:GetDescendants()) do
                        if p:IsA("BasePart") then
                            originalCollisions[p] = p.CanCollide
                            p.CanCollide = false
                        end
                    end
                end)
            end
        else
            -- 復元
            if grabbedObject then
                for part, state in pairs(originalCollisions) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = state end)
                    end
                end
                grabbedObject = nil
                originalCollisions = {}
            end
        end
    end)
else
    warn("GrabNotifyEventが見つかりませんでした。このゲームでは動作しない可能性があります。")
end

-- --- NinjaKunai生成 ---
local function spawnKunaiAtStomach()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local menuToys = ReplicatedStorage:WaitForChild("MenuToys", 5)
        if menuToys then
            local spawnToyRF = menuToys:WaitForChild("SpawnToyRemoteFunction", 5)
            if spawnToyRF then
                spawnToyRF:InvokeServer("NinjaKunai", hrp.CFrame, Vector3.new(0, 0, 0))
            end
        end
    end
end

-- --- UI ---
local Tab = Window:MakeTab({
    Name = "Main Features",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        if Value then
            pcall(spawnKunaiAtStomach)
            -- 同期ロジックの開始 (既存のRenderStepped処理)
            task.spawn(function()
                while _G.AntiKickEnabled do
                    local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and toysFolder then
                        for _, toy in pairs(toysFolder:GetChildren()) do
                            if toy.Name == "NinjaKunai" then
                                pcall(function()
                                    if toy:IsA("Model") and toy.PrimaryPart then
                                        toy:SetPrimaryPartCFrame(hrp.CFrame)
                                    elseif toy:IsA("BasePart") then
                                        toy.CFrame = hrp.CFrame
                                    end
                                end)
                            end
                        end
                    end
                    RunService.RenderStepped:Wait()
                end
            end)
        end
    end
})

Tab:AddToggle({
    Name = "掴みキル & すり抜け",
    Default = false,
    Callback = function(Value)
        _G.GrabKillEnabled = Value
    end
})

OrionLib:Init()
