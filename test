end)

local Window = OrionLib:MakeWindow({
    Name = "Advanced Grab Mod v4", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "GrabModConfig",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- --- 変数管理 ---
_G.AntiKickEnabled = false
_G.GrabKillEnabled = false
_G.GrabNoclipEnabled = false
_G.SuperThrowEnabled = false
_G.ThrowPower = 500 -- デフォルトの投げ強度

local lastGrabbedPart = nil
local originalCollisions = {}

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            task.wait(0.05)
            local target = findGrabbedTarget()
            if target then
                lastGrabbedPart = target
                
                -- 1. キル処理 (独立トグル)
                if _G.GrabKillEnabled then
                    local char = target.Parent
                    local hum = char:FindFirstChild("Humanoid") or char.Parent:FindFirstChild("Humanoid")
                    if hum then hum.Health = 0 end
                end

                -- 2. 壁すり抜け処理 (独立トグル)
                if _G.GrabNoclipEnabled then
                    local root = target.Parent:IsA("Model") and target.Parent or target
                    pcall(function()
                        for _, p in pairs(root:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalCollisions[p] = p.CanCollide
                                p.CanCollide = false
                            end
                        end
                    end)
                end
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- 3. スーパースロー処理
                if _G.SuperThrowEnabled then
                    pcall(function()
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end

                -- 当たり判定の復元
                for part, state in pairs(originalCollisions) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = state end)
                    end
                end
                
                originalCollisions = {}
                -- 投げた後に少し待ってから参照を消す
                task.delay(0.1, function() lastGrabbedPart = nil end)
            end
        end
    end)
end

-- --- NinjaKunai (アンチキック) ロジック ---
local function spawnKunai()
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local rf = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
        if rf then rf:InvokeServer("NinjaKunai", hrp.CFrame, Vector3.zero) end
    end
end

-- --- UI構成 ---
local MainTab = Window:MakeTab({ Name = "Main", Icon = "rbxassetid://4483345998" })

-- アンチキック
MainTab:AddToggle({
    Name = "アンチキック (NinjaKunai)",
    Default = false,
    Callback = function(v)
        _G.AntiKickEnabled = v
        if v then
            spawnKunai()
            task.spawn(function()
                while _G.AntiKickEnabled do
                    local toys = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and toys then
                        for _, t in pairs(toys:GetChildren()) do
                            if t.Name == "NinjaKunai" then
                                pcall(function()
                                    local root = t:IsA("BasePart") and t or (t:IsA("Model") and (t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")))
                                    if root and t:IsA("Model") and not t.PrimaryPart then t.PrimaryPart = root end

                                    local parts = t:GetDescendants()
                                    if t:IsA("BasePart") then table.insert(parts, t) end

                                    for _, p in pairs(parts) do
                                        if p:IsA("BasePart") then
                                            p.CanCollide = false
                                            p.CanQuery = false
                                            p.CanTouch = false
                                            p.Anchored = false 
                                            p.Massless = true
                                        end
                                    end

                                    if root then
                                        if root:FindFirstChild("OwnerWeld") then root.OwnerWeld:Destroy() end
                                        
                                        if t:IsA("Model") then t:PivotTo(hrp.CFrame)
                                        else t.CFrame = hrp.CFrame end

                                        root.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity
                                        root.AssemblyAngularVelocity = hrp.AssemblyAngularVelocity
                                    end
                                end)
                            end
                        end
                    end
                    RunService.Stepped:Wait()
                end
            end)
        end
    end
})

