local decoyConnection = nil
MainTab:AddToggle({
    Name = "Decoy Sync",
    Default = false,
    Callback = function(v)
        _G.DecoyEnabled = v
        if v then
            local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
            
            -- Spawner Loop
            task.spawn(function()
                while _G.DecoyEnabled do
                    local toyFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                    if toyFolder then
                        local decoys = {}
                        for _, obj in ipairs(toyFolder:GetChildren()) do
                            if obj.Name == "YouDecoy" then table.insert(decoys, obj) end
                        end
                        
                        if #decoys < _G.DecoyCount then
                            local rf = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
                            if rf and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                rf:InvokeServer("YouDecoy", localPlayer.Character.HumanoidRootPart.CFrame, Vector3.zero)
                            end
                        end
                    end
                    task.wait(1)
                end
            end)

            if decoyConnection then decoyConnection:Disconnect() end
            decoyConnection = RunService.Heartbeat:Connect(function()
                if not _G.DecoyEnabled then 
                    if decoyConnection then decoyConnection:Disconnect() decoyConnection = nil end
                    return 
                end
                
                local char = localPlayer.Character
                local toyFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                local decoys = {}
                if toyFolder then
                    for _, obj in ipairs(toyFolder:GetChildren()) do
                        if obj.Name == "YouDecoy" then table.insert(decoys, obj) end
                    end
                else
                    local d = Workspace:FindFirstChild("YouDecoy")
                    if d then table.insert(decoys, d) end
                end

                if char and char:FindFirstChild("HumanoidRootPart") then
                    local partsToSync = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart"}
                    local offset = Vector3.new(_G.DecoyOffsetX, _G.DecoyOffsetY, _G.DecoyOffsetZ)
                    local hrp = char.HumanoidRootPart
                    local rightVec = hrp.CFrame.RightVector
                    
                    local charHum = char:FindFirstChild("Humanoid")
                    local charAnimator = charHum and charHum:FindFirstChildOfClass("Animator")

                    for i, decoy in ipairs(decoys) do
                        if i > _G.DecoyCount then break end
                        
                        pcall(function()
                            for _, part in pairs(decoy:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = false
                                    part.Anchored = false
                                    part.Massless = true
                                end
                            end
                        end)
                        
                        -- Animation Sync
                        if charAnimator then
                            local decoyHum = decoy:FindFirstChild("Humanoid")
                            if decoyHum then
                                local decoyAnimator = decoyHum:FindFirstChildOfClass("Animator")
                                if not decoyAnimator then
                                    decoyAnimator = Instance.new("Animator")
                                    decoyAnimator.Parent = decoyHum
                                end
                                
                                local playingTracks = charAnimator:GetPlayingAnimationTracks()
                                local decoyTracks = decoyAnimator:GetPlayingAnimationTracks()
                                
                                for _, track in ipairs(playingTracks) do
                                    local targetTrack = nil
                                    for _, dt in ipairs(decoyTracks) do
                                        if dt.Animation.AnimationId == track.Animation.AnimationId then
                                            targetTrack = dt
                                            break
                                        end
                                    end
                                    if not targetTrack then
                                        targetTrack = decoyAnimator:LoadAnimation(track.Animation)
                                        targetTrack:Play()
                                    end
                                    if targetTrack then
                                        targetTrack.TimePosition = track.TimePosition
                                        targetTrack:AdjustSpeed(track.Speed)
                                        targetTrack:AdjustWeight(track.WeightCurrent)
                                    end
                                end
                                
                                for _, dt in ipairs(decoyTracks) do
                                    local isPlaying = false
                                    for _, track in ipairs(playingTracks) do
                                        if track.Animation.AnimationId == dt.Animation.AnimationId then
                                            isPlaying = true
                                            break
                                        end
                                    end
                                    if not isPlaying then
                                        dt:Stop()
                                    end
                                end
                            end
                        end

                        local lineOffset = rightVec * ((i - 1) - (#decoys - 1) / 2) * _G.DecoySpacing
                        
                        for _, partName in pairs(partsToSync) do
                            local charPart = char:FindFirstChild(partName)
                            local decoyPart = decoy:FindFirstChild(partName)
                            if charPart and decoyPart then
                                local targetCF = charPart.CFrame + offset + lineOffset
                                decoyPart.CFrame = targetCF
                                decoyPart.Velocity = Vector3.zero
                                decoyPart.RotVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end)
        else
            if decoyConnection then decoyConnection:Disconnect() decoyConnection = nil end
        end
    end
})

