local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick System v2.1", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false

-- --- NinjaKunai生成メインロジック ---
local function spawnKunaiAtBody()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 画像に基づいたリモート関数の取得
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        
        -- 横（X）と高さ（Y）は維持し、前後（Z）を0.2（少し後ろ）に調整
        -- 前回の -0.5 より 0.7スタッド後ろに下がります
        local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, 0.2) 
        
        spawnToyRF:InvokeServer(
            "NinjaKunai", 
            spawnCFrame, 
            Vector3.new(0, 0, 0)
        )
    end
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai Loop)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "位置を微調整してクナイ生成を開始しました",
                Time = 3
            })
            
            task.spawn(function()
                while _G.AntiKickEnabled do
                    pcall(spawnKunaiAtBody)
                    task.wait(5) -- サーバー負荷を抑えるための待機時間
                end
            end)
        end
    end
})

Tab:AddLabel("※CFrame.new(0, 0, 0.2) で前後位置を調整済み")

OrionLib:Init()
