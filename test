    Icon = "rbxassetid://4483345998"
})

Tab:AddButton({
    Name = "バリア破壊(TP) 実行",
    Callback = function()
        local result, err = executeBarrierBreak()
        if result then
            OrionLib:MakeNotification({
                Name = "Success",
                Content = "バリアを突破しました",
                Time = 3
            })
        else
            OrionLib:MakeNotification({
                Name = "Failed",
                Content = "失敗しました: " .. tostring(err),
                Time = 3
            })
        end
    end
})

Tab:AddLabel("※画像内の座標データをそのまま使用しています")

