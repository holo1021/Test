local Loadstring = loadstring or getgenv().loadstring or getfenv().loadstring
local HttpGet = game.HttpGet
if not (Loadstring and HttpGet) then return end

local Repository = "https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/main/"
local PlaceId = tostring(game.PlaceId)
local Suffix = "-jp.lua"

local GameScript; 
if not pcall(function()
    GameScript = HttpGet(game, (Repository .. PlaceId .. Suffix))
end) then 
    warn("Script not found for this game in HolonHUB repository.")
    return 
end

Loadstring(GameScript)()
