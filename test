-- --- Silent Aim Logic ---
local function getClosestTarget()
    local mouse = localPlayer:GetMouse()
    local closestDist = 200 -- FOV
    local closestPart = nil
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPart = hrp
                    end
                end
            end
        end
    end
    return closestPart
end

pcall(function()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)
    
    mt.__index = newcclosure(function(self, k)
        if _G.SilentAimEnabled and self == localPlayer:GetMouse() then
            if k == "Target" then
                local t = getClosestTarget()
                if t then return t end
            elseif k == "Hit" then
                local t = getClosestTarget()
                if t then return t.CFrame end
            end
        end
        return oldIndex(self, k)
    end)
    setreadonly(mt, true)
end)

local lastGrabbedPart = nil
local originalCollisions = {}

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            task.wait(0.05)
            local target = findGrabbedTarget()
            if target then
                lastGrabbedPart = target
                
                -- 1. キル処理 (独立トグル)
                if _G.GrabKillEnabled then
                    local char = target.Parent
                    local hum = char:FindFirstChild("Humanoid") or char.Parent:FindFirstChild("Humanoid")
                    if hum then hum.Health = 0 end
                end

                -- 2. 壁すり抜け処理 (独立トグル)
                if _G.GrabNoclipEnabled then
                    local root = target.Parent:IsA("Model") and target.Parent or target
                    pcall(function()
                        for _, p in pairs(root:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalCollisions[p] = p.CanCollide
                                p.CanCollide = false
                            end
                        end
                    end)
                end
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- 3. スーパースロー処理
                if _G.SuperThrowEnabled then
                    pcall(function()
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end

                -- 当たり判定の復元
                for part, state in pairs(originalCollisions) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = state end)
                    end
                end
                
                originalCollisions = {}
                -- 投げた後に少し待ってから参照を消す
                task.delay(0.1, function() lastGrabbedPart = nil end)
            end
        end
    end)
end

-- --- NinjaKunai (アンチキック) ロジック ---
local function spawnKunai()
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local rf = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
        if rf then rf:InvokeServer("NinjaKunai", hrp.CFrame, Vector3.zero) end -- 自分の位置に出現
    end
end

