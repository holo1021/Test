local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "KickBeta Script | Blobman & Sakura",
    LoadingTitle = "KickBeta Script Loading...",
    LoadingSubtitle = "by Lulu",
    ConfigurationSaving = { Enabled = false }
})

-- ====================================================================
-- 変数とサービスの設定
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer

local ToggleStatus = {
    KickAll = false,
    ProtectFriends = false,
    AntiGrab = false
}

-- ====================================================================
-- 便利関数の定義
-- ====================================================================
local function findBlobman()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "CreatureBlobman" and v:FindFirstChild("VehicleSeat") then
            local weld = v.VehicleSeat:FindFirstChild("SeatWeld")
            if weld and weld.Part1 and weld.Part1:IsDescendantOf(LP.Character) then
                return v
            end
        end
    end
    return nil
end

-- ====================================================================
-- タブ作成
-- ====================================================================

local MainTab = Window:CreateTab("Main (Blobman)", 7733916988)
local SakuraTab = Window:CreateTab("External Hubs", 4483362458)
local MiscTab = Window:CreateTab("Misc", 4483345998)

-- --- Main Tab (Blobman機能) ---
MainTab:CreateToggle({
    Name = "Protect Friends (フレンド保護)",
    CurrentValue = false,
    Callback = function(V) ToggleStatus.ProtectFriends = V end,
})

MainTab:CreateToggle({
    Name = "Kick All Loop (全員キック)",
    CurrentValue = false,
    Callback = function(Value)
        ToggleStatus.KickAll = Value
        task.spawn(function()
            while ToggleStatus.KickAll do
                local b = findBlobman()
                if b then
                    for _, target in ipairs(Players:GetPlayers()) do
                        if target ~= LP and target.Character and (not ToggleStatus.ProtectFriends or not LP:IsFriendsWith(target.UserId)) then
                            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                -- 超高速掴み/離し
                                pcall(function()
                                    b.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(b.LeftDetector, hrp, b.LeftDetector:FindFirstChild("LeftWeld"))
                                    task.wait(0.01)
                                    b.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(b.LeftDetector, nil, nil)
                                end)
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end,
})

-- --- Sakura Hub Tab ---
SakuraTab:CreateSection("Sakura Hub")

SakuraTab:CreateButton({
    Name = "Load Sakura Hub (サクラハブを起動)",
    Callback = function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/syumagamingdesu-wq/Sakura-hub/refs/heads/main/FTAP.lua"))()
        Rayfield:Notify({
            Title = "Success",
            Content = "Sakura Hub has been loaded!",
            Duration = 5,
            Image = 4483362458,
        })
    end,
})

-- --- Misc Tab (その他便利機能) ---
MiscTab:CreateToggle({
    Name = "Anti Grab (掴み無効化)",
    CurrentValue = false,
    Callback = function(Value)
        ToggleStatus.AntiGrab = Value
    end,
})

-- 掴み無効化の実行ループ
RunService.Stepped:Connect(function()
    if ToggleStatus.AntiGrab and LP.Character then
        for _, v in ipairs(LP.Character:GetDescendants()) do
            if v:IsA("Weld") or v:IsA("ManualWeld") then
                v:Destroy()
            end
        end
    end
end)
