local Camera = Workspace.CurrentCamera

-- --- 変数管理 ---
_G.SuperThrowEnabled = false
_G.ThrowPower = 500

local ContextActionService = game:GetService("ContextActionService")
local lastGrabbedPart = nil
local forcedParts = {}

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- 固定した対象を可視化するためのSelectionBox
local selectionBox = Instance.new("SelectionBox")
selectionBox.Name = "AnchorSelectionBox"
selectionBox.Color3 = Color3.fromRGB(0, 170, 255) -- 水色
selectionBox.LineThickness = 0.05
selectionBox.Adornee = nil
selectionBox.Parent = game:GetService("CoreGui")

-- --- CFrame Forcing Loop ---
RunService.Heartbeat:Connect(function()
    for part, data in pairs(forcedParts) do
        if part and part.Parent then
            -- 位置更新を停止 (Anchoredを使用するため)
        else
            if data.Gui then data.Gui:Destroy() end
            forcedParts[part] = nil -- Cleanup
        end
    end
end)

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            local target = findGrabbedTarget()
            if not target then
                for i = 1, 20 do
                    RunService.Heartbeat:Wait()
                    target = findGrabbedTarget()
                    if target then break end
                end
            end

            if target then
                lastGrabbedPart = target
                selectionBox.Adornee = target
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- スーパースロー処理
                -- 固定されていないオブジェクトのみスーパースローを適用します
                if _G.SuperThrowEnabled and not forcedParts[lastGrabbedPart] then
                    pcall(function()
                        -- 投げるためにアンカーを外します
                        lastGrabbedPart.Anchored = false
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end
            end
        end
    end)
end

local function handleAnchorAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        if not lastGrabbedPart or not lastGrabbedPart.Parent then
            lastGrabbedPart = findGrabbedTarget()
            if lastGrabbedPart then selectionBox.Adornee = lastGrabbedPart end
        end
        if lastGrabbedPart and lastGrabbedPart.Parent then
            local root = lastGrabbedPart.Parent
            local parts = {}
            if root:IsA("Model") then
                for _, p in pairs(root:GetDescendants()) do
                    if p:IsA("BasePart") then table.insert(parts, p) end
                end
            else
                table.insert(parts, lastGrabbedPart)
            end

            if forcedParts[lastGrabbedPart] then
                for _, p in pairs(parts) do
                    if forcedParts[p] and forcedParts[p].Gui then forcedParts[p].Gui:Destroy() end
                    forcedParts[p] = nil
                    pcall(function() p.Anchored = false end)
                end
            else
                local bg = Instance.new("BillboardGui")
                bg.Name = "AnchorStatusGui"
                bg.Adornee = lastGrabbedPart
                bg.Size = UDim2.new(0, 100, 0, 50)
                bg.StudsOffset = Vector3.new(0, 2, 0)
                bg.AlwaysOnTop = true
                bg.Parent = game:GetService("CoreGui")
                local tl = Instance.new("TextLabel")
                tl.Parent = bg
                tl.Size = UDim2.new(1, 0, 1, 0)
                tl.BackgroundTransparency = 1
                tl.Text = "固定中"
                tl.TextColor3 = Color3.new(1, 0, 0)
                tl.TextStrokeTransparency = 0
                tl.TextSize = 20
                
                for _, p in pairs(parts) do
                    local gui = (p == lastGrabbedPart) and bg or nil
                    forcedParts[p] = { CFrame = p.CFrame, Gui = gui }
                    pcall(function() p.Anchored = true end)
                end
            end
        else
            OrionLib:MakeNotification({Name="Info", Content="対象なし", Time = 1})
        end
    end
end
