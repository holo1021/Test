local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Grab Hub v3.4 - TP Barrier", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "RobloxGrabHub",
    IntroEnabled = false
})

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- TPバリア破壊のメイン関数
local function executeTPBarrierBreak()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 画像内のロジックに基づく座標移動 (CFrameの書き換え)
        -- 注意: 座標値はゲーム内のバリアの内側に合わせて調整が必要です
        local targetCFrame = CFrame.new(184.148, -5.548, 498.136) 
        
        hrp.CFrame = targetCFrame
        
        OrionLib:MakeNotification({
            Name = "Success",
            Content = "TP Barrier Break Executed",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    else
        OrionLib:MakeNotification({
            Name = "Error",
            Content = "Character RootPart not found",
            Image = "rbxassetid://4483345998",
            Time = 3
        })
    end
end

-- --- UI構成 ---

local Tab = Window:MakeTab({
    Name = "TP Barrier",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- TPバリア破壊実行ボタン
Tab:AddButton({
    Name = "バリア破壊 (TP実行)",
    Callback = function()
        executeTPBarrierBreak()
    end
})

-- 特定の地点（家の外など）への復帰ボタン
Tab:AddButton({
    Name = "座標リセット (家の外へTP)",
    Callback = function()
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and _G.SavedPositionOutHouse then
            hrp.CFrame = _G.SavedPositionOutHouse
        else
            OrionLib:MakeNotification({
                Name = "Error",
                Content = "Saved position not found",
                Time = 3
            })
        end
    end
})

-- 座標保存（現在地を復帰地点にする）
Tab:AddButton({
    Name = "現在の座標を保存",
    Callback = function()
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            _G.SavedPositionOutHouse = hrp.CFrame
            OrionLib:MakeNotification({
                Name = "Saved",
                Content = "Current position saved as 'OutHouse'",
                Time = 3
            })
        end
    end
})

OrionLib:Init()
