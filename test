local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "KickBeta Script | Blobman & Sakura",
    LoadingTitle = "KickBeta Script Loading...",
    LoadingSubtitle = "by Lulu",
    ConfigurationSaving = { Enabled = false }
})

-- ====================================================================
-- 変数とサービスの設定
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer

local ToggleStatus = {
    KickAll = false,
    ProtectFriends = false,
    AntiGrab = false
}

-- ====================================================================
-- 便利関数の定義
-- ====================================================================
local function findBlobman()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "CreatureBlobman" and v:FindFirstChild("VehicleSeat") then
            local weld = v.VehicleSeat:FindFirstChild("SeatWeld")
            if weld and weld.Part1 and weld.Part1:IsDescendantOf(LP.Character) then
                -- PrimaryPartがない場合は設定する（テレポートに必須）
                if not v.PrimaryPart then
                    v.PrimaryPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
                end
                return v
            end
        end
    end
    return nil
end

-- ====================================================================
-- タブ作成
-- ====================================================================

local MainTab = Window:CreateTab("Main (Blobman)", 7733916988)
local SakuraTab = Window:CreateTab("External Hubs", 4483362458)
local MiscTab = Window:CreateTab("Misc", 4483345998)

-- --- Main Tab (Blobman機能) ---
MainTab:CreateToggle({
    Name = "Protect Friends (フレンド保護)",
    CurrentValue = false,
    Callback = function(V) ToggleStatus.ProtectFriends = V end,
})

MainTab:CreateToggle({
    Name = "Kick All Loop (Void Kick)",
    CurrentValue = false,
    Callback = function(Value)
        ToggleStatus.KickAll = Value
        task.spawn(function()
            while ToggleStatus.KickAll do
                local b = findBlobman()
                if b and b.PrimaryPart then
                    for _, target in ipairs(Players:GetPlayers()) do
                        if not ToggleStatus.KickAll then break end
                        if target ~= LP and target.Character and (not ToggleStatus.ProtectFriends or not LP:IsFriendsWith(target.UserId)) then
                            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                pcall(function()
                                    -- 1. ターゲットの位置へ移動
                                    b.PrimaryPart.Anchored = false
                                    b:SetPrimaryPartCFrame(hrp.CFrame)
                                    task.wait(0.1)
                                    
                                    -- 2. 掴む
                                    local scriptObj = b:FindFirstChild("BlobmanSeatAndOwnerScript")
                                    local grabRemote = scriptObj and (scriptObj:FindFirstChild("CreatureGrab") or scriptObj:FindFirstChild("Grab"))
                                    local dropRemote = scriptObj and (scriptObj:FindFirstChild("CreatureDrop") or scriptObj:FindFirstChild("Drop"))
                                    local lDet = b:FindFirstChild("LeftDetector")
                                    local lWeld = lDet and (lDet:FindFirstChild("LeftWeld") or lDet:FindFirstChild("RigidConstraint"))
                                    
                                    if grabRemote and lDet then
                                        grabRemote:FireServer(lDet, hrp, lWeld)
                                        task.wait(0.2)
                                        
                                        -- 3. 奈落/上空へ移動 (Void Kick)
                                        b:SetPrimaryPartCFrame(CFrame.new(999999, 999999, 999999))
                                        b.PrimaryPart.Velocity = Vector3.new(0, 0, 0)
                                        task.wait(0.1)
                                        
                                        -- 4. 離す
                                        if dropRemote then
                                            local activeWeld = lDet:FindFirstChildWhichIsA("Weld") or lDet:FindFirstChildWhichIsA("RigidConstraint")
                                            if activeWeld then dropRemote:FireServer(activeWeld) end
                                        else
                                            grabRemote:FireServer(lDet, nil, nil)
                                        end
                                    end
                                end)
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end,
})

