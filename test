local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Kick Script (Nearby Only)",
    LoadingTitle = "KickBeta Script Loading...",
    LoadingSubtitle = "by Lulu",
    ConfigurationSaving = { Enabled = false }
})

-- ====================================================================
-- 変数とサービスの設定
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer

local ToggleStatus = {
    KickAll = false,
    ProtectFriends = false,
    KickRange = 50
}

-- ====================================================================
-- 便利関数の定義
-- ====================================================================
local function findBlobman()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "CreatureBlobman" and v:FindFirstChild("VehicleSeat") then
            local weld = v.VehicleSeat:FindFirstChild("SeatWeld")
            if weld and weld.Part1 and weld.Part1:IsDescendantOf(LP.Character) then
                -- PrimaryPartがない場合は設定する（テレポートに必須）
                if not v.PrimaryPart then
                    v.PrimaryPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
                end
                return v
            end
        end
    end
    return nil
end

-- ====================================================================
-- タブ作成
-- ====================================================================

local MainTab = Window:CreateTab("Kick Settings", 7733916988)

-- --- Main Tab (Blobman機能) ---
MainTab:CreateToggle({
    Name = "Protect Friends (フレンド保護)",
    CurrentValue = false,
    Callback = function(V) ToggleStatus.ProtectFriends = V end,
})

MainTab:CreateSlider({
   Name = "Kick Range (範囲)",
   Range = {10, 300},
   Increment = 5,
   Suffix = "Studs",
   CurrentValue = 50,
   Callback = function(Value) ToggleStatus.KickRange = Value end,
})

MainTab:CreateToggle({
    Name = "Kick All Loop (全員キック)",
    CurrentValue = false,
    Callback = function(Value)
        ToggleStatus.KickAll = Value
        task.spawn(function()
            while ToggleStatus.KickAll do
                local b = findBlobman()
                if b then
                    for _, target in ipairs(Players:GetPlayers()) do
                        if not ToggleStatus.KickAll then break end
                        if target ~= LP and target.Character and (not ToggleStatus.ProtectFriends or not LP:IsFriendsWith(target.UserId)) then
                            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                            local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                            if hrp and myHrp and (hrp.Position - myHrp.Position).Magnitude <= ToggleStatus.KickRange then
                                -- 超高速掴み/離し
                                pcall(function()
                                    b.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(b.LeftDetector, hrp, b.LeftDetector:FindFirstChild("LeftWeld"))
                                    task.wait(0.01)
                                    b.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(b.LeftDetector, nil, nil)
                                end)
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end,
})
