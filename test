-- --- Raycast Silent Aim & Trigger Bot Logic ---
local UserInputService = game:GetService("UserInputService")

local function GetDirection(Origin, Position)
    return (Position - Origin).Unit * (Origin - Position).Magnitude
end

local function GetClosestPlayerInWorld()
    local Closest, Distance = nil, _G.SilentAimRange
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= localPlayer then
            local Character = Player.Character
            local Head = Character and Character:FindFirstChild("Head")
            local Humanoid = Character and Character:FindFirstChild("Humanoid")
            if Head and (Humanoid and Humanoid.Health > 0) then
                local _Distance = (hrp.Position - Head.Position).Magnitude
                if _Distance <= Distance then
                    Closest = Head
                    Distance = _Distance
                end
            end
        end
    end
    return Closest
end

local LastTriggerTime = 0
local TriggerConnection = nil

local function UpdateTriggerBot()
    if TriggerConnection then
        TriggerConnection:Disconnect()
        TriggerConnection = nil
    end
    
    if _G.TriggerBotEnabled then
        TriggerConnection = RunService.Heartbeat:Connect(function()
            local CurrentTime = tick()
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                if CurrentTime - LastTriggerTime >= _G.TriggerDelay then
                    local Target = GetClosestPlayerInWorld()
                    if Target then
                        pcall(function()
                            mouse1click()
                        end)
                        LastTriggerTime = CurrentTime
                    end
                end
            end
        end)
        OrionLib:MakeNotification({Name = "Trigger Bot", Content = "Activated", Time = 3})
    else
        OrionLib:MakeNotification({Name = "Trigger Bot", Content = "Deactivated", Time = 3})
    end
end

local oldNamecall = nil
local function HookSilentAim()
    if oldNamecall then return end
    oldNamecall = hookmetamethod(game, "__namecall", function(...)
        local Method = getnamecallmethod()
        local Arguments = {...}
        if _G.RaycastSilentAimEnabled and Arguments[1] == Workspace and Method == "Raycast" then
            if typeof(Arguments[#Arguments]) ~= "RaycastParams" then
                return oldNamecall(...)
            end
            local HitPart = GetClosestPlayerInWorld()
            if HitPart then
                Arguments[3] = GetDirection(Arguments[2], HitPart.Position)
                return oldNamecall(unpack(Arguments))
            end
        end
        return oldNamecall(...)
    end)
end

local lastGrabbedPart = nil
local originalCollisions = {}

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
    end

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            local target = findGrabbedTarget()
            if not target then
                for i = 1, 20 do
                    RunService.Heartbeat:Wait()
                    target = findGrabbedTarget()
                    if target then break end
                end
            end

            if target then
                lastGrabbedPart = target
                
                -- 1. キル処理 (独立トグル)
                if _G.GrabKillEnabled then
                    local char = target.Parent
                    local hum = char:FindFirstChild("Humanoid") or char.Parent:FindFirstChild("Humanoid")
                    if hum then hum.Health = 0 end
                end

                -- 2. 壁すり抜け処理 (独立トグル)
                if _G.GrabNoclipEnabled then
                    local root = target.Parent:IsA("Model") and target.Parent or target
                    pcall(function()
                        for _, p in pairs(root:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalCollisions[p] = p.CanCollide
                                p.CanCollide = false
                            end
                        end
                    end)
                end

                -- 回転処理
				if _G.GrabSpinEnabled then
					task.spawn(function()
						local partToSpin = lastGrabbedPart

						while partToSpin and partToSpin.Parent and _G.GrabSpinEnabled do
							pcall(function()
								partToSpin.AssemblyAngularVelocity = Vector3.new(0, 100, 0)
							end)
							RunService.Heartbeat:Wait()
						end
						if partToSpin and partToSpin.Parent then
							pcall(function() partToSpin.AssemblyAngularVelocity = Vector3.zero end)
						end
					end)
				end
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- 3. スーパースロー処理
                if _G.SuperThrowEnabled then
                    pcall(function()
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end
                
                -- 投げた後に少し待ってから参照を消す
                task.delay(0.1, function() lastGrabbedPart = nil end)
            end
            -- 当たり判定の復元
            for part, state in pairs(originalCollisions) do
                if part and part.Parent then
                    pcall(function() part.CanCollide = state end)
                end
            end
            originalCollisions = {}
        end
    end)
end

