local function canPressPianoKey() return pianoEnabled end

-- 1. وظيفة الضغط على مفتاح البيانو
local function pressPianoKey(keyName)
    -- البحث مباشرة عن MusicKeyboard في كل مرة
    local targetKeyboard = getMusicKeyboard()
    
    -- إذا لم يتم العثور عليه، اخرج
    if not targetKeyboard then return end

    if not canPressPianoKey() then return end

    local key = targetKeyboard:FindFirstChild(keyName, true)
    if key and key:IsA("BasePart") then
        -- تعيين مالك الشبكة (إخطار الخادم)
        SetNetworkOwner:FireServer(key, key.CFrame)
        
        -- وقت الانتظار المحدد
        task.wait(0.15)
    end

    -- عملية التسجيل
    if isRecording and canPressPianoKey() then
        table.insert(recordedNotes, {key = keyName, time = tick()})
    end
end

-- 2. وظيفة التشغيل من JSON
local function playSongFromJSON(jsonData)
    if isPlayingSong then return end
    
    local songData
    local success, err = pcall(function()
        -- إذا كانت سلسلة، قم بفك تشفيرها؛ إذا كانت جدولاً، استخدمها كما هي
        if type(jsonData) == "string" then
            return HttpService:JSONDecode(jsonData)
        else
            return jsonData
        end
    end)
    
    if not success or type(err) ~= "table" then
        warn("فشل تحميل بيانات JSON")
        return
    end
    songData = err

    isPlayingSong = true
    print("بدء الأداء: " .. #songData .. " نوتة")
    
    task.spawn(function()
        -- العثور على البيانو مرة واحدة قبل بدء الأداء
        if not pianoKeyboard then pianoKeyboard = getMusicKeyboard() end
        
        for i, note in ipairs(songData) do
            -- التوقف فقط عند الضغط على زر "إيقاف"
            if not isPlayingSong then break end
            
            local rawKey = tostring(note.key)
            -- إذا كان مفتاح JSON يبدأ بـ "Key"، استخدمه كما هو دون تحويل (لمنع التحويل الخاطئ)
            local keyName = rawKey
            if not string.match(rawKey, "^Key") then
                keyName = pianoKeyMap[rawKey] or rawKey
            end
            
            local delayTime = note.delay or 0.1
            
            -- الضغط باستخدام نفس الآلية مثل الاختبار
            task.spawn(function()
                pressPianoKey(keyName)
            end)
            
            -- الانتظار حتى النوتة التالية
            task.wait(delayTime)
        end
        
        isPlayingSong = false
        print("انتهى الأداء")
    end)
end

-- إيقاف تشغيل الأغنية
local function stopSong()
    isPlayingSong = false
end

-- وظيفة حفظ التسجيل (يتم استدعاؤها من واجهة المستخدم)
_G.HolonSaveRecording = function(filename)
    if #recordedNotes == 0 then 
        OrionLib:MakeNotification({Name="حفظ", Content="لا توجد بيانات تسجيل", Time=3})
        return 
    end
    
    -- حساب التأخير بين النوتات وإنشاء بيانات للحفظ
    local finalData = {}
    for i = 1, #recordedNotes do
        local current = recordedNotes[i]
        local nextNote = recordedNotes[i+1]
        local delay = 0.1
        if nextNote then
            delay = nextNote.time - current.time
        end
        table.insert(finalData, {key = current.key, delay = delay})
    end
    
    local fname = filename
    if not fname or fname == "" then
        -- التسمية التلقائية: Test_1, Test_2 ...
        local idx = 1
        while isfile("FTAP_Notes/Test_" .. idx .. ".json") do
            idx = idx + 1
        end
        fname = "Test_" .. idx
    end
    
    if not fname:match("%.json$") then fname = fname .. ".json" end
    
    local success, json = pcall(function() return HttpService:JSONEncode(finalData) end)
    if success then
        writefile("FTAP_Notes/" .. fname, json)
        OrionLib:MakeNotification({Name="حفظ", Content="تم حفظ " .. fname, Time=3})
        isRecording = false
    else
        warn("خطأ في تشفير JSON")
    end
end

