local function getOrSpawnBlobman()
    local blobman = nil
    local spawned = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    if spawned then blobman = spawned:FindFirstChild("CreatureBlobman") end
    
    if not blobman then
        local mt = ReplicatedStorage:FindFirstChild("MenuToys")
        local st = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
        if st then
            local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            local spawnCF = myRoot and (myRoot.CFrame + Vector3.new(0, 5, 0)) or CFrame.new(0, 50, 0)
            st:InvokeServer("CreatureBlobman", spawnCF, Vector3.zero)
            task.wait(0.5)
            spawned = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
            if spawned then blobman = spawned:FindFirstChild("CreatureBlobman") end
        end
    end

    if not blobman then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.Name == "CreatureBlobman" and obj:FindFirstChild("VehicleSeat") then
                blobman = obj
                break
            end
        end
    end
    
    if blobman and not blobman.PrimaryPart then
        local root = blobman:FindFirstChildWhichIsA("BasePart")
        if root then blobman.PrimaryPart = root end
    end

    return blobman
end

local function kickPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == localPlayer or not targetPlayer.Character then return end
    
    local blobman = getOrSpawnBlobman()
    if not blobman then
        OrionLib:MakeNotification({ Name = "Error", Content = "Blobman not found/spawned", Time = 3 })
        return
    end

    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local s = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
    local g = s and (s:FindFirstChild("CreatureGrab") or s:FindFirstChild("Grab"))
    local l, r = blobman:FindFirstChild("LeftDetector"), blobman:FindFirstChild("RightDetector")
    
    if not g or not blobman.PrimaryPart then
        OrionLib:MakeNotification({ Name = "Error", Content = "Could not find grab remote or primary part.", Time = 3 })
        return
    end

    blobman.PrimaryPart.Anchored = false
    blobman:SetPrimaryPartCFrame(hrp.CFrame)
    task.wait(0.1)

    if l then g:FireServer(l, hrp) end
    if r then g:FireServer(r, hrp) end
    task.wait(0.05)
    
    pcall(function()
        blobman:SetPrimaryPartCFrame(CFrame.new(hrp.Position.X, 999999, hrp.Position.Z))
        if blobman.PrimaryPart then 
            blobman.PrimaryPart.Velocity = Vector3.new(0, 1e6, 0) 
        end
    end)
end


