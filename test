local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Grab Hub v3.4 - Barrier Edition", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "RobloxGrabHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- バリア破壊用変数
local autoBarrierNoTPRunning = false
local autoBarrierNoTPToggle = nil

-- バリア破壊のメインロジック (画像内のロジックを再現)
local function executeBarrierBreakNoTP()
    local success, err = pcall(function()
        local character = localPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            error("Character not found")
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then error("Humanoid not found") end

        -- 動作を安定させるため一時的に停止
        humanoid.WalkSpeed = 0
        
        local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
        local spawnToyRF = menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction")
        
        if not spawnToyRF then
            humanoid.WalkSpeed = 16
            error("MenuToys not found")
        end

        -- 画像に基づいた座標とアイテム(Ocarina)の生成
        -- ※座標は画像から読み取った代表値を設定しています
        local spawnResult = spawnToyRF:InvokeServer(
            "InstrumentWoodwindOcarina", 
            CFrame.new(184.148, -5.548, 498.136, 0.829, -0.214, 0.516, 0, 0.923, 0.383, -0.559, -0.318, 0.765),
            Vector3.new(0, 34, 0)
        )

        if not spawnResult then
            humanoid.WalkSpeed = 16
            error("Spawn failed")
        end

        task.wait(1) -- 生成待ち

        -- 判定の上書き（Campfire等の追加生成ロジックが必要な場合）
        -- ここに画像後半のCampfireセクションを追加可能

        humanoid.WalkSpeed = 16
        return true
    end)

    return success, err
end

-- --- UI構成 ---

local Tab = Window:MakeTab({
    Name = "Barrier Break",
    Icon = "rbxassetid://4483345998"
})

-- オートバリア破壊 (No TP)
autoBarrierNoTPToggle = Tab:AddToggle({
    Name = "オートバリア破壊 NoTP",
    Default = false,
    Callback = function(Value)
        autoBarrierNoTPRunning = Value
        if Value then
            OrionLib:MakeNotification({
                Name = "スタート",
                Content = "成功するまで自動実行します",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
            
            task.spawn(function()
                while autoBarrierNoTPRunning do
                    -- 家の中にいないかチェックするロジック (画像参照)
                    local plotItems = Workspace:FindFirstChild("PlotItems")
                    local playersInPlots = plotItems and plotItems:FindFirstChild("PlayersInPlots")
                    
                    if playersInPlots and playersInPlots:FindFirstChild(localPlayer.Name) then
                        OrionLib:MakeNotification({
                            Name = "Error",
                            Content = "Don't be in the house",
                            Time = 3
                        })
                        autoBarrierNoTPRunning = false
                        autoBarrierNoTPToggle:Set(false)
                        break
                    end

                    local success, err = executeBarrierBreakNoTP()
                    if success then
                        OrionLib:MakeNotification({
                            Name = "成功",
                            Content = "バリア破壊成功",
                            Time = 3
                        })
                        autoBarrierNoTPRunning = false
                        autoBarrierNoTPToggle:Set(false)
                        break
                    else
                        OrionLib:MakeNotification({
                            Name = "失敗",
                            Content = "再試行中...",
                            Time = 2
                        })
                    end
                    task.wait(1.5)
                end
            end)
        else
            OrionLib:MakeNotification({
                Name = "ストップ",
                Content = "自動実行を停止しました",
                Time = 2
            })
        end
    end
})

Tab:AddButton({
    Name = "手動バリア破壊 (一度だけ実行)",
    Callback = function()
        executeBarrierBreakNoTP()
    end
})

OrionLib:Init()
