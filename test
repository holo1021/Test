-- ライブラリの読み込み
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 既存のUIを削除して衝突を防ぐ
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

-- ウィンドウ作成
local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick Simple", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickSimple",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

_G.AntiKickEnabled = false

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "お腹の位置で生成を開始しました（非同期）",
                Time = 3
            })
            
            task.spawn(function()
                while _G.AntiKickEnabled do
                    local char = localPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
                        
                        -- お腹あたりの位置（腰から少し上、少し前）
                        local stomachPos = hrp.CFrame * CFrame.new(0, 0.4, -0.2)
                        
                        pcall(function()
                            spawnToyRF:InvokeServer("NinjaKunai", stomachPos, Vector3.new(0, 0, 0))
                        end)
                    end
                    task.wait(8) -- 生成間隔
                end
            end)
        end
    end
})

-- 【重要】これを最後に書かないとUIが表示されません
OrionLib:Init()
