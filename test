})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false
_G.GrabKillEnabled = false -- 新規：掴みキルの有効フラグ
local grabbedObject = nil
local originalCollisions = {}

-- --- GrabNotifyEventの取得 --- 
local grabNotify = localPlayer:WaitForChild("PlayerScripts"):WaitForChild("CharacterAndBeamMove"):WaitForChild("GrabNotifyEvent")

-- --- NinjaKunai生成ロジック ---
local function spawnKunaiAtStomach()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        local stomachCFrame = hrp.CFrame
        spawnToyRF:InvokeServer("NinjaKunai", stomachCFrame, Vector3.new(0, 0, 0))
    end
end

-- --- 掴んだ対象を特定する関数 ---
local function findGrabbedTarget()
    -- 元のスクリプトが生成するGrabPartsから対象を取得
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- --- 掴みイベントの監視ロジック ---
grabNotify.Event:Connect(function(isGrabbing)
    if not _G.GrabKillEnabled then return end

    if isGrabbing then
        task.wait(0.05) -- 接続完了まで僅かに待機
        local target = findGrabbedTarget()
        
        if target then
            grabbedObject = target
            local character = target.Parent
            local humanoid = character:FindFirstChild("Humanoid") or character.Parent:FindFirstChild("Humanoid")

            -- 1. キル処理
            if humanoid then
                humanoid.Health = 0
            end

            -- 2. すり抜け処理 (CanCollide = false) 
            local root = character:IsA("Model") and character or target
            for _, p in pairs(root:GetDescendants()) do
                if p:IsA("BasePart") then
                    originalCollisions[p] = p.CanCollide
                    p.CanCollide = false
                end
            end
        end
    else
        -- 離した時に当たり判定を復元
        if grabbedObject then
            for part, state in pairs(originalCollisions) do
                if part and part.Parent then
                    part.CanCollide = state
                end
            end
            grabbedObject = nil
            originalCollisions = {}
        end
    end
end)

-- --- クナイ同期ロジック ---
local syncConnection = nil
local function startSync()
    if syncConnection then syncConnection:Disconnect() end
    syncConnection = RunService.RenderStepped:Connect(function()
        if not _G.AntiKickEnabled then 
            if syncConnection then syncConnection:Disconnect() end
            return 
        end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if hrp and toysFolder then
            for _, toy in pairs(toysFolder:GetChildren()) do
                if toy.Name == "NinjaKunai" then
                    local targetCFrame = hrp.CFrame
                    if toy:IsA("Model") then
                        if toy.PrimaryPart then toy:SetPrimaryPartCFrame(targetCFrame)
                        elseif toy:FindFirstChild("Handle") then toy.Handle.CFrame = targetCFrame end
                        for _, part in pairs(toy:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false [cite: 2]
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    elseif toy:IsA("BasePart") then
                        toy.CFrame = targetCFrame
                        toy.CanCollide = false [cite: 2]
                        toy.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
    end)
end

