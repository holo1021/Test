    Min = 0, Max = 5000, Default = cfg.GrabMod.ThrowPower,
    Increment = 100, ValueName = "قوة",
    Callback = function(v) cfg.GrabMod.ThrowPower = v end
})

local DetailTab = Window:MakeTab({Name = "تفاصيل", Icon = DetailIcon})
AddDetailContent(DetailTab)

-- إشعار (عند البدء)
OrionLib:MakeNotification({
    Name = "Holon HUB",
    Content = "!تم تحميل Holon HUB v1.4.3",
    Time = 5
})
    -- تطبيق نمط واجهة المستخدم عند البدء
    applyCustomStyle()

    -- تهيئة جانب الشاشة الرئيسية
    OrionLib:Init()
end

if isfile(KeyFileName) and readfile(KeyFileName) == CorrectKey then
    -- إذا تمت المصادقة، انتقل مباشرة إلى الرئيسية
    StartHolonHUB()
else
    -- إذا لم تتم المصادقة، قم بإنشاء واجهة مستخدم للمصادقة
    local OrionLib = loadstring(game:HttpGet(OrionUrl))()
    
    local AuthWindow = OrionLib:MakeWindow({
        Name = "Holon HUB | نظام المفاتيح",
        HidePremium = true,
        IntroEnabled = false
    })

    local AuthTab = AuthWindow:MakeTab({Name = "مصادقة", Icon = "rbxassetid://7733919526"})
    local KeyInput = ""

    AuthTab:AddTextbox({
        Name = "أدخل المفتاح",
        Default = "",
        TextDisappear = false, -- تم تغيير هذا إلى false
        Callback = function(Value) 
            KeyInput = Value 
        end     
    })

    AuthTab:AddButton({
        Name = "تحقق",
        Callback = function()
            if KeyInput == CorrectKey then
                writefile(KeyFileName, CorrectKey) -- حفظ هنا
                OrionLib:MakeNotification({Name = "نجاح", Content = "جاري البدء!", Time = 2})
                task.wait(1)
                pcall(function() game.CoreGui.Orion:Destroy() end)
                task.wait(0.5)
                StartHolonHUB()
            else
                OrionLib:MakeNotification({Name = "فشل", Content = "مفتاح غير صحيح", Time = 5})
            end
        end
    })

    AuthTab:AddButton({
        Name = "الحصول على المفتاح (Discord)",
        Callback = function() setclipboard("https://discord.gg/EHBXqgZZYN") end
    })

    -- علامة تبويب التفاصيل
    local AuthDetailTab = AuthWindow:MakeTab({Name = "تفاصيل", Icon = DetailIcon})
    AddDetailContent(AuthDetailTab)
    
    OrionLib:Init()
end
