local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick System v2", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false

-- --- NinjaKunai生成メインロジック ---
local function spawnKunaiAtBody()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 画像で見られたSpawnToyの仕組みを流用
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        
        -- 現在の体(HRP)の位置から、正面に0.5スタッドだけずらして重なるように設定
        local spawnCFrame = hrp.CFrame * CFrame.new(0, 0, -0.5) 
        
        spawnToyRF:InvokeServer(
            "NinjaKunai", 
            spawnCFrame, 
            Vector3.new(0, 0, 0)
        )
    end
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック (NinjaKunai Loop)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "体と重なる位置でクナイの生成を開始しました",
                Time = 3
            })
            
            task.spawn(function()
                while _G.AntiKickEnabled do
                    pcall(spawnKunaiAtBody)
                    task.wait(5) -- サーバーへの負荷と検知を考慮して5秒間隔
                end
            end)
        end
    end
})

OrionLib:Init()
