-- --- Raycast Silent Aim & Trigger Bot Logic ---
local UserInputService = game:GetService("UserInputService")

local function GetDirection(Origin, Position)
    return (Position - Origin).Unit * (Origin - Position).Magnitude
end

local function GetClosestPlayerInWorld()
    local Closest, Distance = nil, _G.SilentAimRange
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local playersToConsider = {}
    if #_G.SilentAimSelectedTargets > 0 then
        for _, name in ipairs(_G.SilentAimSelectedTargets) do
            local p = Players:FindFirstChild(name)
            if p and p ~= localPlayer then table.insert(playersToConsider, p) end
        end
    else
        playersToConsider = Players:GetPlayers()
    end

    for _, Player in ipairs(playersToConsider) do
        local Character = Player.Character
        local Head = Character and Character:FindFirstChild("Head")
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        if Head and (Humanoid and Humanoid.Health > 0) then
            local _Distance = (hrp.Position - Head.Position).Magnitude
            if _Distance <= Distance then
                Closest = Head
                Distance = _Distance
            end
        end
    end
    return Closest
end

local LastTriggerTime = 0
local TriggerConnection = nil

local function UpdateTriggerBot()
    if TriggerConnection then
        TriggerConnection:Disconnect()
        TriggerConnection = nil
    end
    
    if _G.TriggerBotEnabled then
        TriggerConnection = RunService.Heartbeat:Connect(function()
            local CurrentTime = tick()
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                if CurrentTime - LastTriggerTime >= _G.TriggerDelay then
                    local Target = GetClosestPlayerInWorld()
                    if Target then
                        pcall(function()
                            mouse1click()
                        end)
                        LastTriggerTime = CurrentTime
                    end
                end
            end
        end)
        OrionLib:MakeNotification({Name = "Trigger Bot", Content = "Activated", Time = 3})
    else
        OrionLib:MakeNotification({Name = "Trigger Bot", Content = "Deactivated", Time = 3})
    end
end

local oldNamecall = nil
local function HookSilentAim()
    if oldNamecall then return end
    oldNamecall = hookmetamethod(game, "__namecall", function(...)
        local Method = getnamecallmethod()
        local Arguments = {...}
        if _G.RaycastSilentAimEnabled and Arguments[1] == Workspace and Method == "Raycast" then
            if typeof(Arguments[#Arguments]) ~= "RaycastParams" then
                return oldNamecall(...)
            end
            local HitPart = GetClosestPlayerInWorld()
            if HitPart then
                Arguments[3] = GetDirection(Arguments[2], HitPart.Position)
                return oldNamecall(unpack(Arguments))
            end
        end
        return oldNamecall(...)
    end)
end

-- --- CFrame Forcing Loop ---
RunService.Heartbeat:Connect(function()
    for part, data in pairs(forcedParts) do
        if part and part.Parent then
            -- 位置更新を停止 (Anchoredを使用するため)
        else
            if data.Gui then data.Gui:Destroy() end
            forcedParts[part] = nil -- Cleanup
        end
    end
end)

-- --- メインロジック監視 ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            local target = findGrabbedTarget()
            if not target then
                for i = 1, 20 do
                    RunService.Heartbeat:Wait()
                    target = findGrabbedTarget()
                    if target then break end
                end
            end

            if target then
                lastGrabbedPart = target
                selectionBox.Adornee = target
            end
        else
            -- 離した時 (投げた時)
            if lastGrabbedPart then
                -- スーパースロー処理
                -- 固定されていないオブジェクトのみスーパースローを適用します
                if _G.SuperThrowEnabled and not forcedParts[lastGrabbedPart] then
                    pcall(function()
                        -- 投げるためにアンカーを外します
                        lastGrabbedPart.Anchored = false
                        -- 物理演算の主導権があるうちに力を加える
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end
            end
        end
    end)
end

local function handleAnchorAction(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        if not lastGrabbedPart or not lastGrabbedPart.Parent then
            lastGrabbedPart = findGrabbedTarget()
            if lastGrabbedPart then selectionBox.Adornee = lastGrabbedPart end
        end
        if lastGrabbedPart and lastGrabbedPart.Parent then
            local root = lastGrabbedPart.Parent
            local parts = {}
            if root:IsA("Model") then
                for _, p in pairs(root:GetDescendants()) do
                    if p:IsA("BasePart") then table.insert(parts, p) end
                end
            else
                table.insert(parts, lastGrabbedPart)
            end

            if forcedParts[lastGrabbedPart] then
                for _, p in pairs(parts) do
                    if forcedParts[p] and forcedParts[p].Gui then forcedParts[p].Gui:Destroy() end
                    forcedParts[p] = nil
                    pcall(function() p.Anchored = false end)
                end
            else
                local bg = Instance.new("BillboardGui")
                bg.Name = "AnchorStatusGui"
                bg.Adornee = lastGrabbedPart
                bg.Size = UDim2.new(0, 100, 0, 50)
                bg.StudsOffset = Vector3.new(0, 2, 0)
                bg.AlwaysOnTop = true
                bg.Parent = game:GetService("CoreGui")
                local tl = Instance.new("TextLabel")
                tl.Parent = bg
                tl.Size = UDim2.new(1, 0, 1, 0)
                tl.BackgroundTransparency = 1
                tl.Text = "固定中"
                tl.TextColor3 = Color3.new(1, 0, 0)
                tl.TextStrokeTransparency = 0
                tl.TextSize = 20
                
                for _, p in pairs(parts) do
                    local gui = (p == lastGrabbedPart) and bg or nil
                    forcedParts[p] = { CFrame = p.CFrame, Gui = gui }
                    pcall(function() p.Anchored = true end)
                end
            end
        else
            OrionLib:MakeNotification({Name="Info", Content="対象なし", Time = 1})
        end
    end
end
