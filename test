local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick Only", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickSimple",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false

-- --- NinjaKunai生成ロジック (お腹の位置) ---
local function spawnKunaiAtStomach()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
        
        local stomachCFrame = hrp.CFrame
        
        spawnToyRF:InvokeServer(
            "NinjaKunai", 
            stomachCFrame, 
            Vector3.new(0, 0, 0)
        )
    end
end

-- --- クナイ同期ロジック ---
local syncConnection = nil

local function startSync()
    if syncConnection then syncConnection:Disconnect() end

    syncConnection = RunService.RenderStepped:Connect(function()
        if not _G.AntiKickEnabled then 
            if syncConnection then syncConnection:Disconnect() end
            return 
        end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        
        if hrp and toysFolder then
            for _, toy in pairs(toysFolder:GetChildren()) do
                if toy.Name == "NinjaKunai" then
                    local targetCFrame = hrp.CFrame
                    if toy:IsA("Model") then
                        if toy.PrimaryPart then
                            toy:SetPrimaryPartCFrame(targetCFrame)
                        elseif toy:FindFirstChild("Handle") then
                            toy.Handle.CFrame = targetCFrame
                        end
                        -- 物理演算の影響を排除して固定を強化
                        for _, part in pairs(toy:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    elseif toy:IsA("BasePart") then
                        toy.CFrame = targetCFrame
                        toy.CanCollide = false
                        toy.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
    end)
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Anti-Kick",
    Icon = "rbxassetid://4483345998"
})

Tab:AddToggle({
    Name = "アンチキック開始 (NinjaKunai)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        
        if Value then
            OrionLib:MakeNotification({
                Name = "System",
                Content = "クナイの生成と追従を開始しました",
                Time = 3
            })
            
            pcall(spawnKunaiAtStomach)
            startSync()
        end
    end
})

Tab:AddLabel("※クナイは常に自分のお腹の位置に追従します。")

OrionLib:Init()
