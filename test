end)

local Window = OrionLib:MakeWindow({
    Name = "Ultra Grab Mod V2", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "GrabModConfigV2",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- --- 変数管理 ---
_G.AntiKickEnabled = false
_G.GrabKillEnabled = false
_G.GrabNoclipEnabled = false
_G.SuperThrowEnabled = false
_G.ThrowPower = 500
_G.GrabCount = 0 -- すり抜け用のカウント

local lastGrabbedPart = nil
local originalCollisions = {}

-- --- 通知イベントの取得 ---
local function getGrabNotify()
    local ps = localPlayer:WaitForChild("PlayerScripts", 10)
    if not ps then return nil end
    local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
    if not cbm then return nil end
    return cbm:WaitForChild("GrabNotifyEvent", 10)
end

local grabNotify = getGrabNotify()

-- --- ターゲット特定ロジック ---
local function findGrabbedTarget()
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        local grabPart = grabParts:FindFirstChild("GrabPart")
        if grabPart then
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if weld and weld.Part1 then
                return weld.Part1
            end
        end
    end
    return nil
end

-- --- 改良版キル関数 ---
local function killTarget(target)
    if not target then return end
    -- パーツの親、そのまた親まで検索してHumanoidを探す
    local character = target.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid") or (character.Parent and character.Parent:FindFirstChildOfClass("Humanoid"))
    
    if humanoid then
        humanoid.Health = 0
        -- ローカルで死なない場合への対策（念のため）
        humanoid.MaxHealth = 0 
    end
end

-- --- メインロジック ---
if grabNotify then
    grabNotify.Event:Connect(function(isGrabbing)
        if isGrabbing then
            _G.GrabCount = _G.GrabCount + 1 -- 掴むたびにカウントアップ
            task.wait(0.05)
            local target = findGrabbedTarget()
            if target then
                lastGrabbedPart = target
                
                -- 1. キル処理
                if _G.GrabKillEnabled then
                    killTarget(target)
                end

                -- 2. すり抜け処理 (2回以上掴んでいる場合のみ)
                if _G.GrabNoclipEnabled and _G.GrabCount >= 2 then
                    local root = target.Parent:IsA("Model") and target.Parent or target
                    pcall(function()
                        for _, p in pairs(root:GetDescendants()) do
                            if p:IsA("BasePart") then
                                originalCollisions[p] = p.CanCollide
                                p.CanCollide = false
                            end
                        end
                    end)
                end
            end
        else
            -- 離した時
            if lastGrabbedPart then
                -- スーパースロー
                if _G.SuperThrowEnabled then
                    pcall(function()
                        local force = Camera.CFrame.LookVector * _G.ThrowPower
                        lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                    end)
                end

                -- 当たり判定復元
                for part, state in pairs(originalCollisions) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = state end)
                    end
                end
                originalCollisions = {}
                
                -- 投げた後にリセット（連続で投げるときのため）
                -- ※もし「一度離してもカウントを維持したい」場合はここを消してください
                -- _G.GrabCount = 0 
                
                task.delay(0.1, function() lastGrabbedPart = nil end)
            end
        end
    end)
end

