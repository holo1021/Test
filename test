local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/hololove1021/HolonHUB/refs/heads/main/source.txt')))()

-- 二重起動防止
pcall(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then 
        game:GetService("CoreGui").Orion:Destroy() 
    end
end)

local Window = OrionLib:MakeWindow({
    Name = "Anti-Kick & Sync Hub", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "AntiKickHub",
    IntroEnabled = false
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- 変数管理
_G.AntiKickEnabled = false
_G.GlobalSyncEnabled = false
local syncConnection = nil

-- --- 同期メインロジック (クナイとデコイの両方を体にくっつける) ---
local function startGlobalSync()
    if syncConnection then syncConnection:Disconnect() end

    syncConnection = RunService.RenderStepped:Connect(function()
        if not _G.GlobalSyncEnabled then 
            if syncConnection then syncConnection:Disconnect() end
            return 
        end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local toysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        
        if hrp and toysFolder then
            -- 前回の微調整に基づき、少し後ろ(0.2)の位置を計算
            local targetCFrame = hrp.CFrame * CFrame.new(0, 0, 0.2)
            
            for _, toy in pairs(toysFolder:GetChildren()) do
                -- NinjaKunai または YouDecoy を対象にする
                if toy.Name == "NinjaKunai" or toy.Name == "YouDecoy" or toy:FindFirstChild("Humanoid") then
                    if toy:IsA("Model") then
                        toy:SetPrimaryPartCFrame(targetCFrame)
                    elseif toy:IsA("BasePart") then
                        toy.CFrame = targetCFrame
                    end
                end
            end
        end
    end)
end

-- --- UI構成 ---
local Tab = Window:MakeTab({
    Name = "Main Control",
    Icon = "rbxassetid://4483345998"
})

-- 1. 同期トグル（これを入れるとクナイもデコイも体に固定されます）
Tab:AddToggle({
    Name = "アイテムを体に同期 (Kunai/Decoy)",
    Default = false,
    Callback = function(Value)
        _G.GlobalSyncEnabled = Value
        if Value then
            OrionLib:MakeNotification({Name = "Sync", Content = "同期開始: アイテムが体に固定されます", Time = 3})
            startGlobalSync()
        else
            if syncConnection then syncConnection:Disconnect() end
        end
    end
})

-- 2. アンチキック（クナイを出す）
Tab:AddToggle({
    Name = "アンチキック (NinjaKunai生成)",
    Default = false,
    Callback = function(Value)
        _G.AntiKickEnabled = Value
        if Value then
            task.spawn(function()
                while _G.AntiKickEnabled do
                    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
                        -- 生成（同期がONなら、生成直後に体に吸い付きます）
                        spawnToyRF:InvokeServer("NinjaKunai", hrp.CFrame * CFrame.new(0, 0, 0.2), Vector3.new(0, 0, 0))
                    end
                    task.wait(10) -- 生成の間隔（同期しているので長めでOK）
                end
            end)
        end
    end
})

Tab:AddButton({
    Name = "YouDecoyを配置",
    Callback = function()
        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local spawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            spawnToyRF:InvokeServer("YouDecoy", hrp.CFrame, Vector3.new(0, 0, 0))
        end
    end
})

OrionLib:Init()
