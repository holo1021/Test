local kickTargetName = ""
local selectedTargets = {}
local TargetsLabel = MainTab:AddParagraph("Target List", "None")

local function getPList()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= localPlayer then
            table.insert(list, v.DisplayName .. " (@" .. v.Name .. ")")
        end
    end
    return list
end

local function updateTargetsLabel()
    if #selectedTargets == 0 then
        TargetsLabel:Set("Target List", "None")
    else
        TargetsLabel:Set("Target List", table.concat(selectedTargets, ", "))
    end
end

local KickDropdown = MainTab:AddDropdown({
    Name = "Select Player",
    Default = "Select Player",
    Options = getPList(),
    Callback = function(v)
        kickTargetName = v:match("@([^)]+)")
    end
})

MainTab:AddButton({
    Name = "Add/Remove Selected to List",
    Callback = function()
        if kickTargetName ~= "" then
            local found = false
            for i, v in ipairs(selectedTargets) do
                if v == kickTargetName then
                    table.remove(selectedTargets, i)
                    found = true
                    break
                end
            end
            if not found then
                table.insert(selectedTargets, kickTargetName)
            end
            updateTargetsLabel()
        end
    end
})

MainTab:AddButton({
    Name = "Refresh Player List",
    Callback = function()
        KickDropdown:Refresh(getPList(), true)
    end
})

MainTab:AddButton({
    Name = "Grab Selected Players",
    Callback = function()
        local targetsToGrab = {}
        if #selectedTargets > 0 then
            for _, name in ipairs(selectedTargets) do
                local p = Players:FindFirstChild(name)
                if p then table.insert(targetsToGrab, p) end
            end
        elseif kickTargetName ~= "" then
            local p = Players:FindFirstChild(kickTargetName)
            if p then table.insert(targetsToGrab, p) end
        end

        local blobman = getOrSpawnBlobman()
        if #targetsToGrab == 0 or not blobman then 
            OrionLib:MakeNotification({Name = "Error", Content = "No targets or Blobman failed", Time = 3})
            return 
        end

        -- 1. 乗る
        local seat = blobman:FindFirstChild("VehicleSeat")
        local hum = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
        if seat and hum and seat.Occupant ~= hum then
            pcall(function()
                localPlayer.Character.HumanoidRootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
                seat:Sit(hum)
            end)
            task.wait(0.2)
        end

        -- 2. 掴む
        local scriptObj = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
        local grabRemote = scriptObj and (scriptObj:FindFirstChild("CreatureGrab") or scriptObj:FindFirstChild("Grab"))
        local lDet, rDet = blobman:FindFirstChild("LeftDetector"), blobman:FindFirstChild("RightDetector")
        local lWeld = lDet and (lDet:FindFirstChild("LeftWeld") or lDet:FindFirstChild("RigidConstraint"))
        local rWeld = rDet and (rDet:FindFirstChild("RightWeld") or rDet:FindFirstChild("RigidConstraint"))

        if grabRemote then
            for _, target in ipairs(targetsToGrab) do
                if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = target.Character.HumanoidRootPart
                    if blobman.PrimaryPart then
                        blobman.PrimaryPart.Anchored = false
                        blobman:SetPrimaryPartCFrame(hrp.CFrame)
                        task.wait(0.1)
                    end
                    if lDet then grabRemote:FireServer(lDet, hrp, lWeld) end
                    if rDet then grabRemote:FireServer(rDet, hrp, rWeld) end
                    task.wait(0.1)
                end
            end
        end
        OrionLib:MakeNotification({ Name = "Done", Content = "Grab attempt finished", Time = 3 })
    end
})

