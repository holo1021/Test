-- [[ 1. وظيفة الشاشة الرئيسية ]]
local function StartHolonHUB()
    -- إصلاح الهاتف المحمول: إعادة تحميل OrionLib داخل الوظيفة
    local OrionLib = loadstring(game:HttpGet(OrionUrl))()
    
    -- حذف واجهة المستخدم الحالية بالقوة (لمنع العرض المزدوج)
    pcall(function()
        if game:GetService("CoreGui"):FindFirstChild("Orion") then 
            game:GetService("CoreGui").Orion:Destroy() 
        end
    end)

    local Window = OrionLib:MakeWindow({
        Name = "Holon HUB v1.4.3 (AR)",
        HidePremium = false,
        SaveConfig = false, -- تعطيل لمنع التداخل عند التهيئة
        ConfigFolder = "HolonHUB",
        IntroEnabled = true,
        IntroText = "!تم تحميل Holon HUB"
    })

    -- [تكامل منطق Grab Mod]
    local function getGrabNotify()
        local ps = LocalPlayer:WaitForChild("PlayerScripts", 10)
        if not ps then return nil end
        local cbm = ps:WaitForChild("CharacterAndBeamMove", 10)
        if not cbm then return nil end
        return cbm:WaitForChild("GrabNotifyEvent", 10)
    end

    local grabNotify = getGrabNotify()
    local lastGrabbedPart = nil
    local grabOriginalCollisions = {}

    local function findGrabbedTarget()
        local grabParts = Workspace:FindFirstChild("GrabParts")
        if grabParts then
            local grabPart = grabParts:FindFirstChild("GrabPart")
            if grabPart then
                local weld = grabPart:FindFirstChild("WeldConstraint")
                if weld and weld.Part1 then
                    return weld.Part1
                end
            end
        end
        return nil
    end

    if grabNotify then
        grabNotify.Event:Connect(function(isGrabbing)
            if isGrabbing then
                local target = findGrabbedTarget()
                if not target then
                    for i = 1, 20 do
                        RunService.Heartbeat:Wait()
                        target = findGrabbedTarget()
                        if target then break end
                    end
                end

                if target then
                    lastGrabbedPart = target
                    
                    if cfg.GrabMod.Kill then
                        local char = target.Parent
                        local hum = char:FindFirstChild("Humanoid") or char.Parent:FindFirstChild("Humanoid")
                        if hum then hum.Health = 0 end
                    end

                    if cfg.GrabMod.Noclip then
                        local root = target.Parent:IsA("Model") and target.Parent or target
                        pcall(function()
                            for _, p in pairs(root:GetDescendants()) do
                                if p:IsA("BasePart") then
                                    grabOriginalCollisions[p] = p.CanCollide
                                    p.CanCollide = false
                                end
                            end
                        end)
                    end

                    if cfg.GrabMod.Spin then
                        task.spawn(function()
                            local partToSpin = lastGrabbedPart
                            while partToSpin and partToSpin.Parent and cfg.GrabMod.Spin do
                                pcall(function()
                                    partToSpin.AssemblyAngularVelocity = Vector3.new(0, 100, 0)
                                end)
                                RunService.Heartbeat:Wait()
                            end
                            if partToSpin and partToSpin.Parent then
                                pcall(function() partToSpin.AssemblyAngularVelocity = Vector3.zero end)
                            end
                        end)
                    end
                end
            else
                if lastGrabbedPart then
                    if cfg.GrabMod.SuperThrow then
                        pcall(function()
                            local force = Camera.CFrame.LookVector * cfg.GrabMod.ThrowPower
                            lastGrabbedPart:ApplyImpulse(force * lastGrabbedPart:GetMass())
                        end)
                    end
                    task.delay(0.1, function() lastGrabbedPart = nil end)
                end
                for part, state in pairs(grabOriginalCollisions) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = state end)
                    end
                end
                grabOriginalCollisions = {}
            end
        end)
    end

